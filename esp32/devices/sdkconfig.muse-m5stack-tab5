# M5Stack Tab5: ESP32-P4 (pre-v3 silicon, v1.x) with 16 MB flash and 32 MB
# PSRAM, 5" 720x1280 MIPI-DSI touch LCD, ES8388 speaker codec and ES7210
# microphones, two PI4IOE5V6408 IO expanders. No radio on the P4: Wi-Fi and
# BLE run on an on-board ESP32-C6 over 4-bit SDIO (esp_hosted).
# Native USB Serial/JTAG (303a:1001). No user button: the touchscreen talks.
# Sources: https://github.com/espressif/esp-bsp/tree/master/bsp/m5stack_tab5,
# https://docs.m5stack.com/en/core/Tab5, m5stack/M5Tab5-UserDemo
# platforms/tab5/sdkconfig (SDIO wiring, C6 target, PSRAM speed),
# esp-hosted-mcu's Kconfig (ESP32P4_TAB5_C6_BOARD); esptool chip-id and
# flash-id on the board for the revision (v1.3) and the flash.
# Load last, after sdkconfig.defaults and sdkconfig.muse.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_MUSE_BOARD_M5STACK_TAB5=y
# Bring-up: start quiet and raise it in settings (plan.md audio safety).
CONFIG_MUSE_DEFAULT_VOLUME=30
# Never configured in Muse builds (app.c skips button_init; the touchscreen
# confirms pairing). GPIO35 is the P4's BOOT strapping pin.
CONFIG_HOMEHUB_BUTTON_GPIO=35
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ESP-IDF 6.0.1 builds for P4 rev v3.x unless told otherwise, and one image
# can't run on both. This Tab5 is rev v1.3.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# 32 MB hex PSRAM. 250 MHz needs a v3.x chip; M5's demo runs 200 MHz.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2

# Wi-Fi and BLE through the C6 (esp_wifi_remote + esp_hosted, SDIO slot 1).
# The preset sets the pins; they are repeated so a renamed preset shows up in
# the overlay check (devices/AGENTS.md step 8).
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=13
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=12
CONFIG_ESP_HOSTED_SDIO_PIN_D0=11
CONFIG_ESP_HOSTED_SDIO_PIN_D1=10
CONFIG_ESP_HOSTED_SDIO_PIN_D2=9
CONFIG_ESP_HOSTED_SDIO_PIN_D3=8
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
# NimBLE runs here; the controller is the C6's, reached over the same link.
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y

# LVGL draw buffers: the BSP's default 50 lines, twice, in PSRAM.
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=50
CONFIG_BSP_LCD_DRAW_BUF_DOUBLE=y
